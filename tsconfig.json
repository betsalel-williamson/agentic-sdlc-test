{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,

    "resolveJsonModule": true,

    /* rootDir is "." so package.json sits inside the compilation and the
       version import in src/cli.ts resolves. Output mirrors that layout:
       dist/src/cli.js next to dist/package.json. See design.md. */
    "rootDir": ".",
    "outDir": "dist",
    "declaration": false,
    "sourceMap": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "package.json"]
}
