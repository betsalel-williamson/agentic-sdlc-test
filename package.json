    "format:check": "prettier --check .",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
