{
  "name": "agentic-sdlc-test",
  "version": "0.1.0",
  "description": "A hello-world CLI exercising the OpenSpec + trunk-based agent workflow.",
  "type": "module",
  "bin": {
    "hello": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
